{
  "name": "@braceml/language-server",
  "version": "0.2.0",
  "description": "BraceML language server: diagnostics, completion and hover for .braceml files and Svelte template blocks",
  "keywords": [
    "braceml",
    "language-server",
    "lsp",
    "svelte"
  ],
  "license": "MIT",
  "author": "pavlovt",
  "homepage": "https://github.com/pavlovt/braceml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/braceml.git",
    "directory": "packages/language-server"
  },
  "bugs": "https://github.com/pavlovt/braceml/issues",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup"
  },
  "bin": {
    "braceml-language-server": "./dist/bin.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "dependencies": {
    "@braceml/core": "workspace:^",
    "@braceml/react": "workspace:^",
    "vscode-languageserver": "^11.0.0",
    "vscode-languageserver-textdocument": "^1.0.16"
  },
  "publishConfig": {
    "access": "public"
  }
}
