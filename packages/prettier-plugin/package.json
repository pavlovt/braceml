{
  "name": "@braceml/prettier-plugin",
  "version": "0.3.0",
  "description": "Prettier plugin for BraceML",
  "keywords": [
    "braceml",
    "template",
    "prettier",
    "prettier-plugin"
  ],
  "license": "MIT",
  "author": "pavlovt",
  "homepage": "https://github.com/pavlovt/braceml#readme",
  "repository": {
