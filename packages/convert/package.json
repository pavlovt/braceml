{
  "name": "@braceml/convert",
  "version": "0.3.0",
  "description": "Convert HTML to BraceML",
  "keywords": [
    "braceml",
    "template",
    "html",
    "template-language",
    "converter"
  ],
  "license": "MIT",
  "author": "pavlovt",
  "homepage": "https://github.com/pavlovt/braceml#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavlovt/braceml.git",
    "directory": "packages/convert"
  },
  "bugs": "https://github.com/pavlovt/braceml/issues",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@braceml/core": "workspace:^",
    "parse5": "^7.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
