{
  "name": "braceml-vscode",
  "private": true,
  "displayName": "BraceML",
  "description": "Syntax highlighting, snippets, diagnostics and completion for BraceML, including <template lang=\"braceml\"> in Svelte files",
  "version": "0.1.0",
  "publisher": "pavlovt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pavlovt/braceml.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "braceml",
    "svelte",
    "template",
    "html"
  ],
  "contributes": {
    "languages": [
      {
        "id": "braceml",
        "aliases": [
          "BraceML",
          "braceml"
        ],
        "extensions": [
          ".braceml"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "svelte"
      }
    ],
    "grammars": [
      {
        "language": "braceml",
        "scopeName": "source.braceml",
        "path": "./syntaxes/braceml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.expression.braceml": "javascript"
        }
      },
      {
        "scopeName": "braceml.svelte.injection",
        "path": "./syntaxes/braceml-svelte.injection.json",
        "injectTo": [
          "source.svelte"
        ],
        "embeddedLanguages": {
          "source.braceml": "braceml"
        }
      },
      {
        "scopeName": "braceml.jsx.injection",
        "path": "./syntaxes/braceml-jsx.injection.json",
        "injectTo": [
          "source.js",
          "source.js.jsx",
          "source.jsx",
          "source.ts",
          "source.tsx"
        ],
        "embeddedLanguages": {
          "source.braceml": "braceml"
        }
      },
      {
        "scopeName": "braceml.markdown.injection",
        "path": "./syntaxes/braceml-markdown.injection.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.braceml": "braceml"
        }
      }
    ],
    "snippets": [
      {
        "language": "braceml",
        "path": "./snippets/braceml.code-snippets"
      },
      {
        "language": "svelte",
        "path": "./snippets/braceml.code-snippets"
      }
    ],
    "configuration": {
      "title": "BraceML",
      "properties": {
        "braceml.allowUnknownTags": {
          "type": "boolean",
          "default": false,
          "description": "Accept any lower-case tag name. Match the allowUnknownTags option of your BraceML compiler."
        }
      }
    }
  },
  "scripts": {
    "build": "pnpm --filter @braceml/core build && tsup",
    "vscode:prepublish": "pnpm build",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.91.0",
    "tsup": "^9.0.0"
  },
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "onLanguage:braceml",
    "onLanguage:svelte",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact"
  ]
}
