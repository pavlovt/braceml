{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@braceml/core": [
        "./packages/core/src/index.ts"
      ],
      "@braceml/html": [
        "./packages/html/src/index.ts"
      ],
      "@braceml/svelte": [
        "./packages/svelte/src/index.ts"
      ],
      "@braceml/react": [
        "./packages/react/src/index.ts"
      ],
      "@braceml/react/compiler": [
        "./packages/react/src/compiler.ts"
      ],
      "@braceml/react/vite": [
        "./packages/react/src/vite.ts"
      ]
    }
  },
  "include": [
    "packages/*/src",
    "editors/*/src",
    "tests",
    "vitest.config.ts"
  ]
}